generator kysely {
    provider = "prisma-kysely"

    output       = "../../src/db"
    fileName     = "types.ts"
    enumFileName = "enums.ts"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model ipban {
    ip String @id
}

model account {
    id Int @id @default(autoincrement())

    username String @unique
    password String

    registration_ip   String?
    registration_date DateTime @default(now())

    muted_until  DateTime?
    banned_until DateTime?

    staffmodlevel Int     @default(0)
    // custom (2026-11-06) - helped test the server before launch. Shows a bronze emblem beside
    // the name in chat (ChatCrown, crown 7) and nothing else: it grants no powers and is not a
    // staffmodlevel, because every rank check in the engine reads "at least" and a veteran must
    // not pass any of them.
    //
    // ON THE ACCOUNT RATHER THAN IN THE SAVE, which is the whole reason it is here: the launch
    // wipe moves character saves away and keeps account rows, so a perm varp would have thrown
    // the rank away on the day it started to mean something.
    veteran       Int     @default(0)

    // custom (2026-11-11) - the Helper rank: answers other players' questions, and carries no
    // powers whatsoever. Shows a blue roundel beside the name in chat (ChatCrown, crown 8). A flag
    // rather than a staffmodlevel for the same reason veteran is one, and more sharply: the whole
    // value of this rank is that there is nothing attached to it to abuse.
    helper        Int     @default(0)
    members       Boolean @default(false)
}

// custom (2026-11-02) - A SAVED LOGIN ON ONE COMPUTER. The client used to keep the player's own
// password in ~/.deathplateau/profiles.properties, encrypted with a key any program on that
// machine can read; the file's own header said to treat a leak as a leaked password. This is the
// replacement: the server issues a token, the client stores that instead, and a leak costs
// something that can be cancelled.
//
// One row per computer, so one can be dropped without touching the others, and so a player can
// be told what is signed in where. Deleting the row is the revocation - there is no flag to get
// out of step with.
model account_token {
    id Int @id @default(autoincrement())

    account_id Int

    // sha256 of the token, hex. A password needs bcrypt because people choose it; a token is 103
    // bits of randomness, so there is nothing to brute-force, and a plain digest can be looked up
    // by value in one indexed query instead of compared against every row.
    token_hash String @unique

    created   DateTime @default(now())
    last_used DateTime @default(now())
    expires   DateTime

    // What signlink.uid said, kept so a list of saved logins can say which computer each is.
    uid        Int?
    created_ip String?

    @@index([account_id])
}

model account_login {
    account_id Int
    profile    String

    logged_in  Int       @default(0)
    login_time DateTime?

    logged_out  Int       @default(0)
    logout_time DateTime?

    @@id([profile, account_id])
}

model hiscore {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value Int
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model hiscore_large {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value BigInt
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model friendlist {
    account_id      Int
    friend_username String
    profile         String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, friend_username])
}

model ignorelist {
    account_id Int
    value      String
    profile    String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, value])
}

model session {
    uuid String @id

    account_id Int
    profile    String
    world      Int
    timestamp  DateTime

    uid Int
    ip  String?
}

model session_log {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event      String
    event_type Int    @default(-1)
}

model session_wealth {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event_type Int @default(-1)

    account_items String @db.MediumText
    account_value Int

    recipient_session String?
    recipient_items   String? @db.MediumText
    recipient_value   Int?
}

model public_chat {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord   Int
    message String
}

model private_chat {
    id Int @id @default(autoincrement())

    account_id Int
    profile    String

    timestamp     DateTime
    coord         Int
    to_account_id Int
    message       String
}

model report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord    Int
    offender String
    reason   Int
}

model input_report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    data Bytes
}
