# This is a comment!
# Uncomment lines if you want to change them from their defaults

## web server
# WEB_PORT=80
# WEB_CORS=false
# WEB_SOCKET_TOKEN_PROTECTION=false

## management server
# WEB_MANAGEMENT_PORT=8898
## loopback only by default - /prometheus and /reboot are not for the internet
# WEB_MANAGEMENT_HOST=127.0.0.1

## game server
# NODE_ID=10
# NODE_PORT=43594
# NODE_MEMBERS=true
# NODE_AUTO_SUBSCRIBE_MEMBERS=true
# NODE_XPRATE=1
# NODE_PRODUCTION=false
## a staff-only world (the dev world): refuse logins below this staff level - 3 = administrator. 0 = everyone
# NODE_MIN_STAFF_LEVEL=0
# NODE_KILLTIMER=50
# NODE_DEBUG=true
# NODE_DEBUG_PROFILE=false
# NODE_DEBUG_SOCKET=false
# NODE_STAFF=pazaz
# NODE_CLIENT_ROUTEFINDER=true
# NODE_SOCKET_TIMEOUT=true
# NODE_WALKTRIGGER_SETTING=0
# NODE_PROFILE=main
## server-side bot players in the Wilderness (src/engine/bot) - the dev world only, never live
# NODE_BOTS=false
## optional JSON of overrides (counts, hotspots, reaction times, death drop...) - see src/engine/bot/BotConfig.ts
# NODE_BOTS_CONFIG=data/config/bots.json
## counts, overriding the file (-1 = use the file / the default of 6 roamers and 4 PKers)
# NODE_BOTS_ROAMERS=-1
# NODE_BOTS_PKERS=-1
# NODE_MAX_PLAYERS=2047
# NODE_MAX_NPCS=8191
# NODE_DEBUGPROC_CHAR=~
## open sockets in total and per address (0 = no limit)
# NODE_MAX_SOCKETS=2048
# NODE_MAX_SOCKETS_PER_IP=16
## behind a tunnel or VPS proxy that sends PROXY protocol: its address(es), comma separated
## (CIDRs work, e.g. 10.8.0.0/24), so players keep their own addresses. Connections from these
## are read for the header - one without any (Tailscale in userspace mode forwards from 127.0.0.1)
## keeps its own address; everyone else connects as normal. playit.gg's agent connects from a random
## 127.x.x.x address, not 127.0.0.1, so behind playit use the whole loopback range: 127.0.0.0/8
# PROXY_PROTOCOL_FROM=
## the login RSA key's private half - make it with `npm run rsa`, never commit it
# LOGIN_RSA_KEY_PATH=data/config/login-rsa.pem

## login server
# LOGIN_SERVER=false
# LOGIN_HOST=localhost
# LOGIN_PORT=43500

## friend server
# FRIEND_SERVER=false
# FRIEND_HOST=localhost
# FRIEND_PORT=45099

## logger server
# LOGGER_SERVER=false
# LOGGER_HOST=localhost
# LOGGER_PORT=43501

## internal servers (login, friend, logger)
## what they listen on - loopback unless a world runs on another machine
# INTERNAL_BIND_HOST=127.0.0.1
## shared by every process; required if INTERNAL_BIND_HOST is not loopback. e.g. `openssl rand -hex 32`
# INTERNAL_SECRET=

## database
# DB_BACKEND=sqlite
# DATABASE_URL=mysql://root:password@localhost:3306/lostcity
# DB_HOST=localhost
# DB_NAME=lostcity
# DB_USER=root
# DB_PASS=password
# KYSELY_VERBOSE=false

## development
# BUILD_JAVA_PATH=java
# BUILD_STARTUP=true
# BUILD_STARTUP_UPDATE=true
# BUILD_VERIFY=true
## BUILD_VERIFY checks the pack files - every config has an id line, every id line has a config.
## BUILD_VERIFY_CACHE checks each packed archive against the ORIGINAL 377 cache, byte for byte.
## It is off by default because a repo with custom content cannot pass it: this one has added locs,
## npcs, objs, seqs, spotanims, varbits, varps and interfaces, and 8 of the 10 archives no longer
## match. Turn it on only on a repo that is meant to reproduce stock 377 exactly.
# BUILD_VERIFY_CACHE=false
# BUILD_VERIFY_FOLDER=true
# BUILD_VERIFY_PACK=true
# BUILD_SRC_DIR=data/src
